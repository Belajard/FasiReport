# --- Database PostgreSQL ---
DATABASE_URL=postgres://fasireport:fasireport@localhost:5432/fasireport
# Supabase: Project Settings > Database > Connection string (Session pooler, port 5432), contoh:
# DATABASE_URL=postgresql://postgres.wmswsxpkrmivhzhirrtb:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# SSL otomatis aktif untuk host supabase; paksa manual dengan DATABASE_SSL=true

# --- Keamanan (WAJIB diganti di production, minimal 24 karakter acak) ---
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=12h

# --- Server API ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=
MAX_UPLOAD_MB=5
